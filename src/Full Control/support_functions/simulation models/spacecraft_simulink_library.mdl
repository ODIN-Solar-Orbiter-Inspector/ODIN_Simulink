    eml {
      isEML		      1
      script		      "function  v2 = TransformVector(q,v1)\n% TransformVector. Transforms a vector from one frame to an"
      "other. \n%\n% Format:\n%   v2 = TransformVector(q,v1)\n% where:\n%   q   is the quaternion representing the tran"
      "sformation\n%   v1  is the vector being transformed.\n%   v2  is the transformed vector.\n\n% compute DCM\nDCM ="
      " [q(1)^2-q(2)^2-q(3)^2+q(4)^2        2*(q(1)*q(2)+q(3)*q(4))        2*(q(1)*q(3)-q(2)*q(4));\n           2*(q(1)"
      "*q(2)-q(3)*q(4))   -q(1)^2+q(2)^2-q(3)^2+q(4)^2	       2*(q(2)*q(3)+q(1)*q(4));\n		   2*(q(1)*q(3)+q(2)*q(4))   "
      "     2*(q(2)*q(3)-q(1)*q(4))   -q(1)^2-q(2)^2+q(3)^2+q(4)^2];\n	   \n% transform vector from one frame to anothe"
      "r\nv2  = DCM*v1;\n\nreturn"
      editorLayout	      "100 M4x1[146 214 1448 880]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
