    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function x_dot = fcn(q,w,T_ext,I_sc)\n\n% derivative of quaternion part of state vector:\nOMEGA  "
      " = [    0  w(3) -w(2)  w(1);\n           -w(3)     0  w(1)  w(2);\n            w(2) -w(1)     0  w(3);\n        "
      "   -w(1) -w(2) -w(3)     0];\nq_dot   = 0.5*OMEGA*q;\n\n\n% derivative of rate vector part of state vector:\nw_d"
      "ot   = inv(I_sc)*(T_ext - cross(w,I_sc*w));\n\n\n% overall state vector derivative:\nx_dot   = [q_dot; w_dot];\n"
      editorLayout	      "100 M4x1[146 74 1448 880]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
